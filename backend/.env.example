# Copy to apps/web/.env.local and apps/worker/.env, then fill in. Never commit real values.

# Where Twilio and Documenso reach the API (an ngrok or Cloudflare tunnel URL when developing locally).
PUBLIC_BASE_URL=http://localhost:3001

# Supabase: local CLI (pnpm --filter @mgc/db db:start prints these) or the MGC-02-LeadPortal project.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Redis from infra/docker.
REDIS_URL=redis://localhost:6379/0

# Twilio master account (each firm sends through its own subaccount).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Shared secret configured in Documenso's webhook settings. Generate: openssl rand -hex 24
DOCUMENSO_WEBHOOK_SECRET=

# Worker
WORKER_CONCURRENCY=10
